import ErrorCalculus.Dirichlet.ImageCoordinates
import ErrorCalculus.Dirichlet.ImageCondExp
import ErrorCalculus.Dirichlet.GammaKernel
import ErrorCalculus.Dirichlet.EIDVectorChain
import Mathlib.LinearAlgebra.Matrix.PosDef

/-!
# Conditional Matrix

## Main results
The conditional covariance for an arbitrary error structure.
-/
noncomputable section
open MeasureTheory Filter Topology
namespace ErrorCalculus.ErrorStructure
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable (S : ErrorStructure Ω μ) {n : ℕ}

/-- The image law used throughout. -/
abbrev eidImageLaw (f : Fin n → S.dom) : Measure (Fin n → ℝ) :=
  imageLaw (fun i => (f i : Lp ℝ 2 μ))

/-- Agreement of the image representative and the coordinatewise representative. -/
theorem imageRepresentative_ae_representativeVec (f : Fin n → S.dom) :
    imageRepresentative (fun i => (f i : Lp ℝ 2 μ)) =ᵐ[μ] S.representativeVec f :=
  (imageRepresentative_ae_eq _).trans (S.coeFn_representativeVec f)

theorem eidImageLaw_eq_map (f : Fin n → S.dom) :
    S.eidImageLaw f = μ.map (S.representativeVec f) :=
  Measure.map_congr (S.imageRepresentative_ae_representativeVec f)

/-- The conditional covariance entry, as an L¹ class under the image law. -/
def imageGammaMatrixGeneral (f : Fin n → S.dom) (i j : Fin n) :
    Lp ℝ 1 (S.eidImageLaw f) :=
  (S.image (fun k => (f k : Lp ℝ 2 μ)) (fun k => (f k).property)).Γ
    (S.imageCoord _ (fun k => (f k).property) i)
    (S.imageCoord _ (fun k => (f k).property) j)

theorem imageGammaMatrixGeneral_measurable (f : Fin n → S.dom) (i j : Fin n) :
    Measurable (S.imageGammaMatrixGeneral f i j) :=
  (Lp.stronglyMeasurable _).measurable

theorem imageGammaMatrixGeneral_symm (f : Fin n → S.dom) (i j : Fin n) :
    S.imageGammaMatrixGeneral f i j = S.imageGammaMatrixGeneral f j i :=
  (S.image _ _).Γ_symm _ _

/-- Conditional expectation identity, with the sigma algebra generated by the
image representative. Replacing it by the coordinatewise representative is a.e. harmless. -/
theorem imageGammaMatrixGeneral_condExp (f : Fin n → S.dom) (i j : Fin n) :
    (fun ω => S.imageGammaMatrixGeneral f i j (S.representativeVec f ω)) =ᵐ[μ]
      μ[⇑(S.Γ (f i) (f j)) | imageSigma (fun k => (f k : Lp ℝ 2 μ))] := by
  have h := S.image_Γ_comp_ae_eq_condExp (fun k => (f k : Lp ℝ 2 μ))
    (fun k => (f k).property) (S.imageCoord _ (fun k => (f k).property) i)
    (S.imageCoord _ (fun k => (f k).property) j)
  simp only [imageLift_imageCoord] at h
  exact ((S.imageRepresentative_ae_representativeVec f).fun_comp
    (S.imageGammaMatrixGeneral f i j)).symm.trans h

theorem imageGammaMatrixGeneral_characterization (f : Fin n → S.dom)
    (i j : Fin n) (h : ImageTest (Fin n → ℝ)) :
    (∫ y, h y * S.imageGammaMatrixGeneral f i j y ∂S.eidImageLaw f) =
      ∫ ω, h (S.representativeVec f ω) * S.Γ (f i) (f j) ω ∂μ := by
  have he := S.image_Γ_characterization (fun k => (f k : Lp ℝ 2 μ))
    (fun k => (f k).property) (S.imageCoord _ (fun k => (f k).property) i)
    (S.imageCoord _ (fun k => (f k).property) j) h h.measurable h.bound
  simp only [imageLift_imageCoord] at he
  exact he.trans (integral_congr_ae ((S.imageRepresentative_ae_representativeVec f).mono
    (fun ω hω => by dsimp only; rw [hω])))

/--
A finite Γ matrix is positive semidefinite on one common set of full measure. This uses rational
tests; no separability of the form domain is required.
-/
theorem gammaMatrix_posSemidef_ae (f : Fin n → S.dom) :
    ∀ᵐ ω ∂μ, (Matrix.of (fun i j => S.Γ (f i) (f j) ω)).PosSemidef := by
  classical
  filter_upwards [gammaGood_ae S f] with ω hω
  apply Matrix.PosSemidef.of_dotProduct_mulVec_nonneg
  · apply Matrix.isHermitian_iff_isSymm.mpr
    ext i j
    exact congrArg (fun g : Lp ℝ 1 μ => g ω) (S.Γ_symm (f j) (f i))
  · intro v
    have h := gammaGood_nonneg S f ω hω (Finsupp.equivFunOnFinite.symm v)
    simpa [kernelForm, Finsupp.linearCombination_apply, Finsupp.sum_fintype,
      rawGammaKernel, dotProduct, Matrix.mulVec, Finset.mul_sum,
      mul_assoc, mul_left_comm, mul_comm] using h

theorem imageGammaMatrixGeneral_posSemidef_ae (f : Fin n → S.dom) :
    ∀ᵐ y ∂S.eidImageLaw f,
      (Matrix.of (fun i j => S.imageGammaMatrixGeneral f i j y)).PosSemidef :=
  (S.image _ _).gammaMatrix_posSemidef_ae (fun i => S.imageCoord _ (fun k => (f k).property) i)

/-- Literal EID measure: restrict before taking the image. -/
def eidMeasure (f : Fin n → S.dom) : Measure (Fin n → ℝ) :=
  (μ.restrict {ω | 0 < (Matrix.of (fun i j => S.Γ (f i) (f j) ω)).det}).map
    (S.representativeVec f)

instance eidMeasure_finite (f : Fin n → S.dom) : IsFiniteMeasure (S.eidMeasure f) := by
  unfold eidMeasure
  infer_instance

end ErrorCalculus.ErrorStructure
