import ErrorCalculus.Dirichlet.ImageStructure
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

noncomputable section
open MeasureTheory Filter Topology
namespace ErrorCalculus
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
variable {m : ℕ} (X : Fin m → Lp ℝ 2 μ)

/-- The sigma algebra generated by the measurable image representative. -/
@[reducible] def imageSigma : MeasurableSpace Ω :=
  MeasurableSpace.comap (imageRepresentative X) inferInstance

theorem imageSigma_le : imageSigma X ≤ ‹MeasurableSpace Ω› :=
  (measurable_imageRepresentative X).comap_le

theorem measurable_imageRepresentative_imageSigma :
    Measurable[imageSigma X] (imageRepresentative X) :=
  Measurable.of_comap_le le_rfl

/-- Finiteness, hence sigma finiteness, is automatic after restriction of the sigma algebra. -/
instance imageSigma_sigmaFinite [IsFiniteMeasure μ] :
    SigmaFinite (μ.trim (imageSigma_le X)) := inferInstance

namespace ErrorStructure
variable [IsProbabilityMeasure μ]
variable (S : ErrorStructure Ω μ) (hX : ∀ i, X i ∈ S.dom)

/-- The defining image identity specialized to a measurable set. -/
theorem image_Γ_setIntegral (F G : (S.image X hX).dom)
    (t : Set (Fin m → ℝ)) (ht : MeasurableSet t) :
    (∫ x in t, (S.image X hX).Γ F G x ∂imageLaw X) =
      ∫ ω in imageRepresentative X ⁻¹' t,
        S.Γ (S.toErrorData.imageLift X F) (S.toErrorData.imageLift X G) ω ∂μ := by
  have h := S.image_Γ_characterization X hX F G _
    (ImageTest.indicator t ht).measurable (ImageTest.indicator t ht).bound
  change (ImageTest.indicator t ht).integral _ = _ at h
  rw [ImageTest.integral_indicator] at h
  rw [h]
  have he : (fun ω => (ImageTest.indicator t ht) (imageRepresentative X ω) *
      S.Γ (S.toErrorData.imageLift X F) (S.toErrorData.imageLift X G) ω) =
      (imageRepresentative X ⁻¹' t).indicator
        (fun ω => S.Γ (S.toErrorData.imageLift X F) (S.toErrorData.imageLift X G) ω) := by
    funext ω
    by_cases hω : imageRepresentative X ω ∈ t <;>
      simp [ImageTest.indicator, Set.indicator, hω]
  rw [he, integral_indicator ((measurable_imageRepresentative X) ht)]

/-- The RN image carré du champ is Mathlib's conditional expectation given X. -/
theorem image_Γ_comp_ae_eq_condExp (F G : (S.image X hX).dom) :
    (fun ω => (S.image X hX).Γ F G (imageRepresentative X ω)) =ᵐ[μ]
      μ[⇑(S.Γ (S.toErrorData.imageLift X F) (S.toErrorData.imageLift X G)) | imageSigma X] := by
  have hi := (L1.integrable_coeFn ((S.image X hX).Γ F G)).comp_measurable
    (measurable_imageRepresentative X)
  apply ae_eq_condExp_of_forall_setIntegral_eq (imageSigma_le X)
    (L1.integrable_coeFn _) (fun _ _ _ => hi.integrableOn)
  · intro s hs _
    obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs
    exact (setIntegral_map ht (Lp.aestronglyMeasurable ((S.image X hX).Γ F G))
      (measurable_imageRepresentative X).aemeasurable).symm.trans
        (S.image_Γ_setIntegral X hX F G t ht)
  · exact ((Lp.stronglyMeasurable ((S.image X hX).Γ F G)).comp_measurable
      (measurable_imageRepresentative_imageSigma X)).aestronglyMeasurable

/-- Bouleau's diagonal definition is recovered. -/
theorem image_Γ_diag_comp_ae_eq_condExp (F : (S.image X hX).dom) :
    (fun ω => (S.image X hX).Γ F F (imageRepresentative X ω)) =ᵐ[μ]
      μ[⇑(S.Γ (S.toErrorData.imageLift X F) (S.toErrorData.imageLift X F)) | imageSigma X] :=
  S.image_Γ_comp_ae_eq_condExp X hX F F

/-- The conditional-expectation identity determines the image function a.e. -/
theorem image_Γ_eq_of_comp_ae_eq_condExp (F G : (S.image X hX).dom)
    (g : (Fin m → ℝ) → ℝ) (hg : Integrable g (imageLaw X))
    (h : (g ∘ imageRepresentative X) =ᵐ[μ]
      μ[⇑(S.Γ (S.toErrorData.imageLift X F) (S.toErrorData.imageLift X G)) | imageSigma X]) :
    g =ᵐ[imageLaw X] ⇑((S.image X hX).Γ F G) := by
  have hm := hg.aestronglyMeasurable
  have he := h.trans (S.image_Γ_comp_ae_eq_condExp X hX F G).symm
  have hc := ae_eq_comp (measurable_imageRepresentative X).aemeasurable hm.ae_eq_mk
  apply hm.ae_eq_mk.trans
  apply (ae_map_iff (measurable_imageRepresentative X).aemeasurable
    (measurableSet_eq_fun hm.measurable_mk (Lp.stronglyMeasurable _).measurable)).mpr
  exact hc.symm.trans he

end ErrorStructure
end ErrorCalculus
