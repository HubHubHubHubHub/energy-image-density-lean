import Foundations.Chaos.Finsupp

noncomputable section
open MeasureTheory Set
open scoped InnerProductSpace
namespace Foundations

/--
Completeness: each finite-coordinate L² space is generated by its finite Hermite
basis, then the cylinder algebra generates the full product sigma algebra.
-/
theorem dense_span_hermiteInf :
    (Submodule.span ℝ (range hermiteInf)).topologicalClosure = ⊤ := by
  let S := (Submodule.span ℝ (range hermiteInf)).topologicalClosure
  apply gaussianCylinder_closed_submodule_eq_top S
    (Submodule.isClosed_topologicalClosure _) 
  intro s u
  have hclosed : IsClosed {v : Lp ℝ 2 (gaussianProduct s) | gaussianCylinderLp s v ∈ S} :=
    (Submodule.isClosed_topologicalClosure _).preimage (gaussianCylinderLp s).continuous
  have hd : Dense (Submodule.span ℝ (range (hermiteNormalizedD (ι := s))) :
      Set (Lp ℝ 2 (gaussianProduct s))) :=
    Submodule.dense_iff_topologicalClosure_eq_top.mpr dense_span_hermiteD
  apply (closure_minimal (t := {v | gaussianCylinderLp s v ∈ S}) ?_ hclosed) (hd u)
  intro v hv
  change gaussianCylinderLp s v ∈ S
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨α,rfl⟩ := hv
    rw [gaussianCylinderLp_hermite]
    exact Submodule.le_topologicalClosure _ (Submodule.subset_span (mem_range_self _))
  | zero => simpa using S.zero_mem
  | add v w hv hw ihv ihw => simpa only [map_add] using S.add_mem ihv ihw
  | smul a v hv ih => simpa only [map_smul] using S.smul_mem a ih

def hermiteBasisInf : HilbertBasis (ℕ →₀ ℕ) ℝ (Lp ℝ 2 gaussianInf) :=
  HilbertBasis.mk orthonormal_hermiteInf (by rw [dense_span_hermiteInf])

@[simp] theorem hermiteBasisInf_apply (α : ℕ →₀ ℕ) : hermiteBasisInf α = hermiteInf α :=
  congrFun (HilbertBasis.coe_mk _ _) α

def hermiteInf_coeff (f : Lp ℝ 2 gaussianInf) (α : ℕ →₀ ℕ) : ℝ := ⟪f,hermiteInf α⟫_ℝ

theorem hasSum_hermiteInf_expansion (f : Lp ℝ 2 gaussianInf) :
    HasSum (fun α => hermiteInf_coeff f α • hermiteInf α) f := by
  simpa [HilbertBasis.repr_apply_apply,hermiteInf_coeff,real_inner_comm] using hermiteBasisInf.hasSum_repr f

theorem sum_sq_hermiteInf_coeff (f : Lp ℝ 2 gaussianInf) :
    ∑' α, (hermiteInf_coeff f α)^2 = ‖f‖^2 := by
  simpa [pow_two,hermiteInf_coeff,real_inner_comm,real_inner_self_eq_norm_sq] using
    hermiteBasisInf.tsum_inner_mul_inner f f

theorem hermite_completeInf (f : Lp ℝ 2 gaussianInf)
    (hf : ∀ α, ⟪f,hermiteInf α⟫_ℝ = 0) : f = 0 := by
  have h := hasSum_hermiteInf_expansion f
  simp only [hermiteInf_coeff,hf,zero_smul] at h
  exact h.unique hasSum_zero

end Foundations
